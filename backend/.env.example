# Copy to backend/.env for local development.

ENVIRONMENT=local

# Overridden by docker-compose for the backend/worker containers; useful for
# running the backend outside Docker (e.g. `uvicorn app.main:app --reload`).
DATABASE_URL=postgresql+asyncpg://mdm:mdm_local_dev@localhost:5432/mdm
REDIS_URL=redis://localhost:6379/0

# Clerk (https://dashboard.clerk.com) - Configure > API Keys.
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# Instance-specific JWKS URL, e.g. https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Claude API (chat-with-data agent). Not required until Phase 1d.
ANTHROPIC_API_KEY=

CORS_ORIGINS=http://localhost:3000
